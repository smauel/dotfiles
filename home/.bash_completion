# standard completions
complete -A binding bind
complete -A setopt set
complete -A shopt shopt
complete -A helptopic help
complete -a alias unalias
complete -b builtin
complete -c type which
complete -d cd pushd rmdir
complete -cf man

_sudo() {
    local input=${COMP_WORDS[COMP_CWORD]}

    if ((COMP_CWORD == 1)); then
        # command
        COMPREPLY=( $(compgen -c -- "$input") )
    else
        # args to the command
        COMPREPLY=( $(compgen -f -- "$input") )
    fi
}
complete -F _sudo sudo

# rg completion
source <(rg --generate complete-bash)

# fzf completion
eval "$(fzf --bash)"

# taskr completion
source "${HOME}/.local/bin/taskr_completion"
